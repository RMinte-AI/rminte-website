{
  "name": "rminte-case-access-local",
  "main": "../../website/_worker.js",
  "compatibility_date": "2026-09-26",
  "assets": { "directory": "../../website", "binding": "ASSETS", "run_worker_first": ["/api/*", "/visitor-language.js"] },
  "services": [{"binding":"CASE_DEMOS","service":"rminte-case-demos"}],
  "d1_databases": [{
    "binding": "CASE_DB",
    "database_name": "rminte-case-access",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
